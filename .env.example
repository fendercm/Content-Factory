# === Yandex AI Studio (основной провайдер) ===
# Получить: console.yandex.cloud → Сервисные аккаунты → создать → роль ai.languageModels.user → API-ключ
# YANDEX_FOLDER_ID — ID каталога (вверху страницы консоли)
YANDEX_API_KEY=your_yandex_api_key_here       # console.yandex.cloud → API-ключи
YANDEX_FOLDER_ID=your_folder_id_here         # console.yandex.cloud → ID каталога (b1g...)

# === LLM-цепочка (utils/llm_client.py) ===
# Порядок: Yandex* → Gemini → Groq → NVIDIA → OpenRouter → Gemma → Cerebras* (* — платные)
GEMINI_API_KEY=your_gemini_api_key_here       # aistudio.google.com — основной бесплатный провайдер (текст, vision, TTS)
# Пиновые 2.x-модели отдают 404 «no longer available to new users» — используем алиасы
GEMINI_MODEL=gemini-flash-lite-latest         # быстрый tier: фильтры, safety, идеи (~500 запросов/день бесплатно)
GEMINI_QUALITY_MODEL=gemini-flash-latest      # сценарии (~20 запросов/день бесплатно, иногда 503 при нагрузке)
GEMMA_MODEL=gemma-4-26b-a4b-it                # последний бесплатный резерв (медленно, 5-40 с)
GROQ_API_KEY=your_groq_api_key_here           # console.groq.com — gpt-oss-120b ~1000 запросов/день бесплатно
GROQ_MODEL=openai/gpt-oss-120b                # llama-3.3-70b-versatile снята 16.08.2026
GROQ_VISION_MODEL=qwen/qwen3.8-27b            # llama-4-scout снята 17.07.2026
# NVIDIA NIM (build.nvidia.com, Developer Program) — ~40 RPM / 10K запросов в день, опционально
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# OpenRouter :free — 50 запросов/день (1000 после пополнения на $10), опционально
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Cerebras — с 2026 бесплатного tier нет (402), в BUDGET_MODE=free не используется
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b

# === Публикация ===
ZERNIO_API_KEY=your_zernio_api_key_here       # zernio.com/dashboard → API Keys
ZERNIO_ACCOUNT_ID=your_account_id_here        # zernio.com/dashboard → Social Accounts

# === Голос ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key    # elevenlabs.io → Profile → API Keys (10k симв/мес бесплатно)
                                               # Голоса: Antoni (male), Rachel (female) — eleven_multilingual_v2
DASHSCOPE_API_KEY=your_dashscope_api_key      # dashscope.aliyuncs.com → API Keys (CosyVoice TTS — 500K симв/мес бесплатно)
                                               # Регистрация: alibaba cloud → DashScope → бесплатный tier
PEXELS_API_KEY=your_pexels_api_key_here       # www.pexels.com/api (видео + фото — один ключ)
# unsplash.com/developers — опционально, резерв для фото
UNSPLASH_ACCESS_KEY=
# pollinations.ai — опционально, сцены для --format story
POLLINATIONS_API_KEY=
# YANDEX_API_KEY и YANDEX_FOLDER_ID указаны выше (используются и для голоса, и для LLM)

# === Research Agent — веб-поиск (все опциональны; без ключей работает DuckDuckGo) ===
# tavily.com — 1000/мес бесплатно
TAVILY_API_KEY=
# brave.com/search/api — 2000/мес
BRAVE_API_KEY=
# serper.dev — 2500/мес
SERPER_API_KEY=

# === Тренды (Trend Scout) ===
YOUTUBE_API_KEY=your_youtube_api_key          # console.cloud.google.com → YouTube Data API v3
FMA_API_KEY=your_fma_api_key                  # freemusicarchive.org → API (Music Agent)

# === AI-видео (Kling 2.6) ===
KIE_API_KEY=your_kie_api_key                  # kie.ai → Dashboard → API Keys (бесплатные кредиты при регистрации)
                                               # ~$0.125 за клип · 5-6 клипов/видео = ~$0.70/видео
                                               # Fallback: Pexels если ключ не задан

# === Изображения ===
PIXAZO_API_KEY=your_pixazo_api_key            # Pixazo API — Flux Schnell (Thumbnail Agent)
PIXAZO_BASE_URL=https://api.pixazo.com/v1     # URL Pixazo API (можно переопределить)

# === Scheduler ===
SCHEDULER_NICHE=психология                    # ниша по умолчанию для scheduler.py
SCHEDULER_NICHES=психология,бизнес            # несколько ниш (через запятую)
SCHEDULER_PLATFORM=tiktok                     # платформа для scheduler.py

# === Multi-niche аккаунты (опционально) ===
# ZERNIO_ACCOUNT_ID_ПСИХОЛОГИЯ=account_id_1
# ZERNIO_ACCOUNT_ID_БИЗНЕС=account_id_2

# === Уведомления ===
TELEGRAM_BOT_TOKEN=your_bot_token_here        # @BotFather в Telegram → /newbot
TELEGRAM_CHAT_ID=your_chat_id_here            # ID чата/канала для алертов

# === База данных ===
DB_PATH=pipeline.db

# === Admin Panel (utils/api_server.py) ===
API_HOST=127.0.0.1                            # 0.0.0.0 — доступ из сети (тогда ADMIN_TOKEN обязателен)
API_PORT=5000
# длинная случайная строка; открыть панель: http://host:5000/?token=...
ADMIN_TOKEN=
# доп. имена/IP для заголовка Host через запятую (при API_HOST=0.0.0.0)
API_ALLOWED_HOSTS=

# === Уборка диска (utils/housekeeping.py, запускается scheduler'ом в 04:00) ===
CLIPS_CACHE_MAX_GB=5                          # лимит кэша стоковых клипов Pexels
# пусто = логи не удаляются; например 30
LOG_RETENTION_DAYS=
# пусто = готовые видео не удаляются; например 60
OUTPUT_RETENTION_DAYS=

# Голос: Gemini TTS (бесплатно, живее edge-tts) → edge-tts → Silero
# off — если важен одинаковый голос во всех роликах (при исчерпании квоты Gemini включится edge-tts)
GEMINI_TTS=on
GEMINI_TTS_MODEL=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts,gemini-3.8-flash-lite-tts
# Whisper для таймингов субтитров (текст субтитров берётся из сценария): base | small | medium
WHISPER_MODEL=base

# Budget mode: free = только бесплатные провайдеры (Gemini/Groq/edge-tts/Pexels/Pillow)
BUDGET_MODE=
# Точечное выключение провайдеров: DISABLED_PROVIDERS=kie,gemini
DISABLED_PROVIDERS=

# VK (сериал: config/series/*.json "also_publish": ["vk"]) — публикация через video.save
# Ключ пользователя-администратора сообщества с правами video, wall, groups, offline.
# Право video новым приложениям VK ID выдают после согласования: devsupport@corp.vk.com
VK_USER_TOKEN=
VK_GROUP_ID=           # ID сообщества числом, без минуса

# Планировщик сериала: один эпизод в день из очереди (main.py --format series --prepare N)
SCHEDULER_MODE=        # series — вместо роликов 3 раза в день
SERIES_ID=kabinet7
SERIES_PLATFORM=youtube
SERIES_PUBLISH_TIME=19:00
